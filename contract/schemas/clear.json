{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clear.json",
  "title": "clear (client → server)",
  "description": "Delete all votes and start a new hidden round with a new roundId. Stale roundId: no change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "roundId"
  ],
  "properties": {
    "type": {
      "const": "clear"
    },
    "roundId": {
      "$ref": "common.json#/$defs/roundId"
    }
  }
}
