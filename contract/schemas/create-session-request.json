{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "create-session-request.json",
  "title": "Create session request",
  "type": "object",
  "additionalProperties": false,
  "required": ["pseudo", "role"],
  "properties": {
    "pseudo": { "$ref": "common.json#/$defs/rawPseudo" },
    "role": { "$ref": "role.json" },
    "deck": {
      "description": "Optional. Without it, the session offers every card of FIBONACCI. A deck that breaks the rules of its family is refused with INVALID_DECK.",
      "$ref": "common.json#/$defs/deck"
    }
  }
}
