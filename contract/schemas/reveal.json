{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reveal.json",
  "title": "reveal (client → server)",
  "description": "Reveal the round. Already revealed or stale roundId: no change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "roundId"
  ],
  "properties": {
    "type": {
      "const": "reveal"
    },
    "roundId": {
      "$ref": "common.json#/$defs/roundId"
    }
  }
}
