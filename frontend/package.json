{
  "name": "planning-poker-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/write-config.mjs --dev && ng serve",
    "build": "node scripts/write-config.mjs && ng build && node scripts/inject-csp.mjs",
    "build:e2e": "node scripts/write-config.mjs --dev && ng build && node scripts/inject-csp.mjs --dev",
    "test": "ng test --watch=false && node --test \"scripts/*.test.mjs\"",
    "e2e": "playwright test",
    "e2e:journeys": "playwright test --config playwright.journeys.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
